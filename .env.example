# Database (SQLite works locally with zero setup; swap the datasource in
# prisma/schema.prisma to "postgresql" and use a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# NextAuth — required in production (any random 32+ char string)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional — email magic link works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks — used to verify webhook signatures
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks — used to verify webhook signatures
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com) — used by /api/contact. Falls back to server-side
# console logging if unset, so the form still works without this.
RESEND_API_KEY=

# Google Analytics (GA4 measurement ID, e.g. G-XXXXXXX) — optional, no
# tracking script loads at all if unset
NEXT_PUBLIC_GA_ID=

# Google Search Console (HTML tag verification value) — optional
GOOGLE_SITE_VERIFICATION=
